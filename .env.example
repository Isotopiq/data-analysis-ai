# Frontend
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:8000

# API
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/appdb
TARGET_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/appdb
EXECUTOR_URL=http://executor:8001
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_BASE_URL=
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000
AUTH_JWT_SECRET=change-me
AUTH_COOKIE_NAME=uda_session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Executor
EXECUTOR_DEFAULT_TIMEOUT_S=60
EXECUTOR_DEFAULT_MEMORY_MB=1024
EXECUTOR_DISABLE_NETWORK=true
